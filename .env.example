# ==============================================================================
# ELECTROCART ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate the required values.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Core Django Settings
# Note: production.py will raise ImproperlyConfigured if DEBUG=True, or if SECRET_KEY
# is empty, starts with "django-insecure", or starts with "CHANGE_ME".
DEBUG=True
# Generate a secure key via: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=CHANGE_ME_GENERATE_YOUR_OWN
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000

# Database Configuration (SQLite by default; PostgreSQL for production)
# SQLite:
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (Production):
# DATABASE_URL=postgres://electrocart:electrocart_password@localhost:5432/electrocart

# Indian Taxation & State Compliance (MANDATORY)
# SELLER_STATE has NO default. Production settings will raise ImproperlyConfigured if omitted.
# In local development, if blank, startup emits a warning and tax calculation calls raise ImproperlyConfigured.
# Example values: "Gujarat", "Maharashtra", "Karnataka", "Delhi"
SELLER_STATE=

# Indian GSTIN (15 characters)
# Leave blank to operate in "Bill of Supply" mode (unregistered seller / composition scheme).
# Once populated, invoices automatically switch to full GST Tax Invoices.
SELLER_GSTIN=

# Legal entity details for invoice headers
SELLER_LEGAL_NAME=
SELLER_ADDRESS=

# Payments: Razorpay (TEST Mode Credentials)
# Obtain test credentials from your Razorpay Dashboard -> Settings -> API Keys.
# Leave blank during initial data ingestion/testing; required when testing payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Infrastructure
# Development default uses console backend (emails print directly to terminal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Electrocart <noreply@electrocart.local>
# Production SMTP settings (uncomment when deploying):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
