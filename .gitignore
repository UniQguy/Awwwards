# ==============================================================================
# ELECTROCART REPOSITORY EXCLUSIONS
# ==============================================================================

# Virtual Environments
venv/
.venv/
env/
ENV/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# Byte-compiled / Optimized Python Files
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# Static Assets & Media (anchored to root so static/media/placeholders/ is preserved)
/staticfiles/
/media/
/static/dist/

# Node & Frontend Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Scraped Data & Raw Imports
# Place your dataset manually at: data/electronics_product.csv
# Scraped marketplace inventory must never be committed to source control.
data/electronics_product.csv
data/*.csv
data/*.zip

# Database & SQLite Artifacts
*.sqlite3*
*.db

# Logs & Diagnostics
*.log

# Editor & OS Artifacts
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/
reports/
/data/
